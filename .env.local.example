# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#
# Leave every value blank (or delete .env.local entirely) to run the site in
# PREVIEW MODE: the public pages render from src/content/defaults.js and /admin
# shows a setup notice instead of a login form. Setting only *some* of these is
# treated as a misconfiguration and fails loudly at boot.
# -----------------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → service_role (SECRET)
# Server-side only. It bypasses Row Level Security — never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Signing key for the admin session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Optional — only needed when SHARING one Supabase project between several
# sites. A dedicated project needs neither.
#
# Prefix on this site's table names. Must match the names created by
# supabase/schema.sql (which ships with the "ar_" prefix). Leave empty for a
# project dedicated to this one site, and remove the prefix from the SQL too.
SUPABASE_TABLE_PREFIX=ar_

# Storage bucket holding this site's uploads. Defaults to "media". One bucket
# can serve every site (rows are separated by site_id, filenames are UUIDs).
SUPABASE_MEDIA_BUCKET=

# -----------------------------------------------------------------------------
# Which website this deployment serves
#
# All content is stored per-site: one row in `sites`, and every other table
# references it. This tells the app which one to render.
#
# Must match a `sites.slug` value. With one deployment per shop, each gets its
# own SITE_SLUG - the usual setup, and it keeps pages statically renderable.
SITE_SLUG=

# Alternatively set this to `host` to serve many shops from ONE deployment,
# matching the request's Host header against `sites.domain`. This makes every
# page dynamically rendered, so only use it when you need it.
SITE_RESOLUTION=
